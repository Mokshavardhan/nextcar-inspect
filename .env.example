# Supabase PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication Secret (change in production to a strong 32+ character random secret)
AUTH_SECRET="nextcar-inspect-local-dev-secret-change-in-production-2026"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateway (Optional - built-in Sandbox Payment Gateway runs automatically if unset)
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Email Notifications via SMTP (Optional - logs locally into Notifications table if unset)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="NextCar Inspect <notifications@nextcarinspect.in>"

# WhatsApp Notifications via Twilio WhatsApp API (Optional - logs locally if unset)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Or WhatsApp Business Cloud API (Optional)
# WHATSAPP_CLOUD_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
